{
	"workbench.colorCustomizations": {
		"titleBar.activeBackground": "#00000000",
		"titleBar.border": "#39CB37",
		"titleBar.activeForeground": "#F0F0F0",
		"statusBar.background": "#191919",
		"statusBar.border": "#39CB37",
		"statusBar.foreground": "#F0F0F0",
		"activityBar.activeBorder": "#39CB37",
		"activityBarBadge.foreground": "#212121",
		"activityBarBadge.background": "#39CB37"
	},
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"files.associations": {
		".ignore": "ignore",
		".gitignore": "ignore"
	},
	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"json.schemaDownload.trustedDomains": {
		"https://raw.githubusercontent.com/DavidAnson/markdownlint/": true
	}
}
